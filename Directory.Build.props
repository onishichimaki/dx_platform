<Project>
  <PropertyGroup>
    <!-- 会社承認済みFrameworkへ変更する場合は、互換性確認後にここだけを変更する。 -->
    <DxTargetFramework>net10.0</DxTargetFramework>
    <TargetFramework>$(DxTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
