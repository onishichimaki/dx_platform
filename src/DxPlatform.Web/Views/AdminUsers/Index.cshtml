@model IReadOnlyList<UserListItemViewModel>
@{ ViewData["Title"] = "ユーザー管理"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2">ユーザー管理</h1><p class="text-secondary mb-0">ユーザーは物理削除せず無効化します。</p></div><a class="btn btn-primary" asp-action="Create">新規登録</a></div>
<form method="get" class="form-section"><div class="input-group"><input name="keyword" value="@ViewBag.Keyword" class="form-control" aria-label="検索キーワード" placeholder="表示名、メール、所属" /><button class="btn btn-primary">検索</button></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>表示名</th><th>メール</th><th>所属</th><th>ロール</th><th>状態</th><th>最終ログイン</th><th>操作</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.DisplayName</td><td>@item.Email</td><td>@(item.Department ?? "-")</td><td>@string.Join(", ", item.Roles)</td><td>@(item.IsActive ? "有効" : "無効")</td><td>@(item.LastLoginAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "未ログイン")</td><td><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">編集</a> @if (item.IsActive) { <a class="btn btn-outline-danger btn-sm" asp-action="Disable" asp-route-id="@item.Id">無効化</a> }</td></tr> }
</tbody></table></div>

