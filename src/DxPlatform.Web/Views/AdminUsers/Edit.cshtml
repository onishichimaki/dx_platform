@model UserEditViewModel
@{
    ViewData["Title"] = Model.Id is null ? "ユーザー登録" : "ユーザー編集";
    var roles = ViewBag.AllRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var groups = ViewBag.AllGroups as IEnumerable<Group> ?? Enumerable.Empty<Group>();
}
<h1 class="h2">@ViewData["Title"]</h1>
<form method="post" class="form-section">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="DisplayName" class="form-label required-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Email" class="form-label required-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" /></div>
        @if (Model.Id is null) { <div class="col-md-6"><label asp-for="InitialPassword" class="form-label required-label"></label><input asp-for="InitialPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="InitialPassword" class="text-danger"></span><div class="form-text">秘密情報として安全な経路で本人へ伝達してください。</div></div> }
        <div class="col-md-3 align-self-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-md-6"><label asp-for="SelectedRoles" class="form-label"></label><select asp-for="SelectedRoles" class="form-select" multiple size="4">@foreach (var role in roles) { <option value="@role">@role</option> }</select></div>
        <div class="col-md-6"><label asp-for="SelectedGroupIds" class="form-label"></label><select asp-for="SelectedGroupIds" class="form-select" multiple size="6">@foreach (var group in groups) { <option value="@group.Id">@group.Name (@group.Code)</option> }</select></div>
    </div>
    <div class="mt-3 d-flex gap-2"><button class="btn btn-primary" type="submit">保存</button><a class="btn btn-outline-secondary" asp-action="Index">キャンセル</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

