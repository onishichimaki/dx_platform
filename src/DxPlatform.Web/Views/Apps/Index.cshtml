@model IReadOnlyList<ApplicationAsset>
@{ ViewData["Title"] = "アプリカタログ"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h2 mb-1">アプリカタログ</h1><p class="text-secondary mb-0">利用権限のあるアプリだけが表示されます。</p></div>
</div>
<form method="get" class="form-section">
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label" for="keyword">キーワード</label><input id="keyword" name="keyword" value="@ViewBag.Keyword" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label" for="type">種別</label><select id="type" name="type" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<ApplicationAssetType>()) { <option value="@value" selected="@(ViewBag.Type?.ToString() == value.ToString())">@value</option> }</select></div>
        <div class="col-md-2"><label class="form-label" for="status">状態</label><select id="status" name="status" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<LifecycleStatus>()) { <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString())">@value</option> }</select></div>
        <div class="col-md-2"><label class="form-label" for="tag">タグ</label><input id="tag" name="tag" value="@ViewBag.Tag" class="form-control" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">検索</button></div>
    </div>
</form>
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead><tr><th>コード</th><th>アプリ名</th><th>種別</th><th>状態</th><th>所有部署</th><th>バージョン</th><th>操作</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td><code>@item.Code</code></td><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.AssetType</td><td><span class="status-badge">@item.Status</span></td><td>@(item.OwnerDepartment ?? "未設定")</td><td>@(item.Version ?? "-")</td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@item.Id">詳細</a></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7"><div class="empty-state">条件に一致する、利用可能なアプリはありません。</div></td></tr> }
    </tbody>
</table>
</div>

