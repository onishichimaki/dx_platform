@model AgentAssetInputModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Agent編集" : "Agent登録";
    var dataAssets = ViewBag.AllDataAssets as IEnumerable<DataAsset> ?? Enumerable.Empty<DataAsset>();
    var tools = ViewBag.AllTools as IEnumerable<ToolAsset> ?? Enumerable.Empty<ToolAsset>();
}
<h1 class="h2">@ViewData["Title"]</h1>
<form method="post" class="form-section"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-3"><label asp-for="AgentType" class="form-label"></label><select asp-for="AgentType" asp-items="Html.GetEnumSelectList<AgentType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<LifecycleStatus>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="Platform" class="form-label required-label"></label><input asp-for="Platform" class="form-control" /><span asp-validation-for="Platform" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ModelName" class="form-label"></label><input asp-for="ModelName" class="form-control" /></div><div class="col-12"><label asp-for="Purpose" class="form-label required-label"></label><textarea asp-for="Purpose" class="form-control" rows="3"></textarea><span asp-validation-for="Purpose" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="OwnerDepartment" class="form-label"></label><input asp-for="OwnerDepartment" class="form-control" /></div><div class="col-md-4"><label asp-for="ManagerName" class="form-label"></label><input asp-for="ManagerName" class="form-control" /></div><div class="col-md-4"><label asp-for="PublicationScope" class="form-label"></label><input asp-for="PublicationScope" class="form-control" /></div>
<div class="col-md-6"><label asp-for="GitHubRepositoryUrl" class="form-label"></label><input asp-for="GitHubRepositoryUrl" class="form-control" /><span asp-validation-for="GitHubRepositoryUrl" class="text-danger"></span></div><div class="col-md-3"><label asp-for="RiskLevel" class="form-label"></label><select asp-for="RiskLevel" asp-items="Html.GetEnumSelectList<RiskLevel>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="EvaluationStatus" class="form-label"></label><select asp-for="EvaluationStatus" asp-items="Html.GetEnumSelectList<EvaluationStatus>()" class="form-select"></select></div>
<div class="col-md-3"><div class="form-check mt-4"><input asp-for="HasWriteOperations" class="form-check-input" /><label asp-for="HasWriteOperations" class="form-check-label"></label></div></div><div class="col-md-3"><div class="form-check mt-4"><input asp-for="SendsDataExternally" class="form-check-input" /><label asp-for="SendsDataExternally" class="form-check-label"></label></div></div><div class="col-md-3"><label asp-for="LastEvaluatedAt" class="form-label"></label><input asp-for="LastEvaluatedAt" class="form-control" /></div><div class="col-md-3"><label asp-for="LastReviewedAt" class="form-label"></label><input asp-for="LastReviewedAt" class="form-control" /></div>
<div class="col-md-3"><label asp-for="PromptVersion" class="form-label"></label><input asp-for="PromptVersion" class="form-control" /></div><div class="col-md-9"><label asp-for="PromptLocationReference" class="form-label"></label><input asp-for="PromptLocationReference" class="form-control" /></div><div class="col-12"><label asp-for="PromptSummary" class="form-label"></label><textarea asp-for="PromptSummary" class="form-control" rows="2"></textarea><div class="form-text">System Prompt本文、認証情報、個人情報は入力しないでください。</div></div><div class="col-md-4"><label asp-for="PromptLastReviewedAt" class="form-label"></label><input asp-for="PromptLastReviewedAt" class="form-control" /></div><div class="col-md-8"><label asp-for="TagsText" class="form-label"></label><input asp-for="TagsText" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
<div class="col-md-6"><label asp-for="RelatedDataAssetIds" class="form-label"></label><select asp-for="RelatedDataAssetIds" class="form-select" multiple size="6">@foreach (var item in dataAssets) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-6"><label asp-for="RelatedToolAssetIds" class="form-label"></label><select asp-for="RelatedToolAssetIds" class="form-select" multiple size="6">@foreach (var item in tools) { <option value="@item.Id">@item.Name (@item.ToolType)</option> }</select></div>
</div><div class="mt-3 d-flex gap-2"><button class="btn btn-primary">保存</button><a class="btn btn-outline-secondary" asp-action="Index">キャンセル</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

