@model ToolAssetInputModel
@{ ViewData["Title"] = "利用ツール/API登録"; }
<h1 class="h2">利用ツール/API登録</h1><p class="text-secondary">Agentが利用するツールまたはAPIのメタデータです。認証情報は登録しません。</p>
<form method="post" class="form-section col-lg-8"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label required-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="ToolType" class="form-label required-label"></label><input asp-for="ToolType" class="form-control" /><span asp-validation-for="ToolType" class="text-danger"></span></div><div class="mb-3"><label asp-for="ReferenceUrl" class="form-label"></label><input asp-for="ReferenceUrl" class="form-control" /><span asp-validation-for="ReferenceUrl" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><button class="btn btn-primary">保存</button> <a class="btn btn-outline-secondary" asp-action="Index">キャンセル</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

