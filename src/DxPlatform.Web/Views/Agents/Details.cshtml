@model AgentAsset
@{
    ViewData["Title"] = "Agent詳細";
    var dataAssets = ViewBag.DataAssets as IEnumerable<DataAsset> ?? Enumerable.Empty<DataAsset>();
    var tools = ViewBag.Tools as IEnumerable<ToolAsset> ?? Enumerable.Empty<ToolAsset>();
}
<div class="d-flex justify-content-between align-items-start mb-3"><div><h1 class="h2">@Model.Name</h1><p class="text-secondary">@Model.AgentType / @Model.Platform / @Model.Status</p></div>@if (User.IsInRole(RoleNames.SystemAdmin) || User.IsInRole(RoleNames.CatalogAdmin)) { <div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">編集</a> <a class="btn btn-outline-danger" asp-action="Disable" asp-route-id="@Model.Id">無効化</a></div> }</div>
<div class="row g-3"><div class="col-lg-8"><section class="form-section"><h2 class="h4">管理・リスク情報</h2><dl class="row detail-list mb-0">
<dt class="col-sm-3">用途</dt><dd class="col-sm-9">@Model.Purpose</dd><dt class="col-sm-3">所有部署</dt><dd class="col-sm-9">@(Model.OwnerDepartment ?? "-")</dd><dt class="col-sm-3">管理責任者</dt><dd class="col-sm-9">@(Model.ManagerName ?? "未設定")</dd><dt class="col-sm-3">利用モデル</dt><dd class="col-sm-9">@(Model.ModelName ?? "-")</dd><dt class="col-sm-3">公開範囲</dt><dd class="col-sm-9">@(Model.PublicationScope ?? "-")</dd><dt class="col-sm-3">書き込み操作</dt><dd class="col-sm-9">@(Model.HasWriteOperations ? "あり" : "なし")</dd><dt class="col-sm-3">外部送信</dt><dd class="col-sm-9">@(Model.SendsDataExternally ? "あり" : "なし")</dd><dt class="col-sm-3">リスク / 評価</dt><dd class="col-sm-9">@Model.RiskLevel / @Model.EvaluationStatus</dd><dt class="col-sm-3">最終評価日</dt><dd class="col-sm-9">@(Model.LastEvaluatedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "未評価")</dd></dl></section>
<section class="form-section"><h2 class="h4">プロンプト管理情報</h2><p class="alert alert-secondary">System Prompt本文は保存しません。</p><dl class="row detail-list mb-0"><dt class="col-sm-3">バージョン</dt><dd class="col-sm-9">@(Model.PromptVersion ?? "-")</dd><dt class="col-sm-3">要約</dt><dd class="col-sm-9">@(Model.PromptSummary ?? "-")</dd><dt class="col-sm-3">保管場所参照</dt><dd class="col-sm-9">@(Model.PromptLocationReference ?? "-")</dd><dt class="col-sm-3">最終レビュー</dt><dd class="col-sm-9">@(Model.PromptLastReviewedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "未確認")</dd></dl></section></div>
<div class="col-lg-4"><section class="form-section"><h2 class="h5">関連データ資産</h2><ul>@foreach (var item in dataAssets) { <li><a asp-controller="DataAssets" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></li> } @if (!dataAssets.Any()) { <li class="text-secondary">なし</li> }</ul><h2 class="h5">利用ツール/API</h2><ul>@foreach (var item in tools) { <li>@item.Name (@item.ToolType)</li> } @if (!tools.Any()) { <li class="text-secondary">なし</li> }</ul></section></div></div>

