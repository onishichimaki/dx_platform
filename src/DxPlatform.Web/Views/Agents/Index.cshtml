@model IReadOnlyList<AgentAsset>
@{ ViewData["Title"] = "Agentカタログ"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2">Agentカタログ</h1><p class="text-secondary mb-0">実行機能ではなく、所在・接続先・リスク・品質・管理責任を管理します。</p></div>@if (User.IsInRole(RoleNames.SystemAdmin) || User.IsInRole(RoleNames.CatalogAdmin)) { <div><a class="btn btn-outline-primary" asp-action="CreateTool">ツール/API登録</a> <a class="btn btn-primary" asp-action="Create">Agent登録</a></div> }</div>
<form method="get" class="form-section"><div class="row g-2 align-items-end"><div class="col-md-4"><label for="keyword" class="form-label">キーワード</label><input id="keyword" name="keyword" value="@ViewBag.Keyword" class="form-control" /></div><div class="col-md-2"><label for="type" class="form-label">種別</label><select id="type" name="type" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<AgentType>()) { <option value="@value" selected="@(ViewBag.Type?.ToString() == value.ToString())">@value</option> }</select></div><div class="col-md-2"><label for="status" class="form-label">状態</label><select id="status" name="status" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<LifecycleStatus>()) { <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString())">@value</option> }</select></div><div class="col-md-2"><label for="risk" class="form-label">リスク</label><select id="risk" name="risk" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<RiskLevel>()) { <option value="@value" selected="@(ViewBag.Risk?.ToString() == value.ToString())">@value</option> }</select></div><div class="col-md-2"><button class="btn btn-primary w-100">検索</button></div></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Agent名</th><th>種別</th><th>プラットフォーム</th><th>状態</th><th>リスク</th><th>評価</th><th>管理責任者</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.AgentType</td><td>@item.Platform</td><td>@item.Status</td><td>@item.RiskLevel</td><td>@item.EvaluationStatus</td><td>@(item.ManagerName ?? "未設定")</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7"><div class="empty-state">Agentはありません。</div></td></tr> }
</tbody></table></div>

