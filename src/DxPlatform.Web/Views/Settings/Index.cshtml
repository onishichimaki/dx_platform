@model IReadOnlyDictionary<string, string>
@{ ViewData["Title"] = "設定"; }
<h1 class="h2">設定状態</h1><div class="alert alert-info">安全な構成状態だけを表示します。接続文字列、パスワード、Tokenなどの値は表示・編集しません。</div>
<div class="col-lg-8"><table class="table"><thead><tr><th>項目</th><th>状態</th></tr></thead><tbody>@foreach (var item in Model) { <tr><th scope="row">@item.Key</th><td>@item.Value</td></tr> }</tbody></table></div>

