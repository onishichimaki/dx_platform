@model IReadOnlyList<DataAsset>
@{ ViewData["Title"] = "データカタログ"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2">データカタログ</h1><p class="text-secondary mb-0">接続文字列やパスワードは保存せず、所在と管理責任を可視化します。</p></div>@if (User.IsInRole(RoleNames.SystemAdmin) || User.IsInRole(RoleNames.CatalogAdmin)) { <a class="btn btn-primary" asp-action="Create">新規登録</a> }</div>
<form method="get" class="form-section"><div class="row g-2 align-items-end"><div class="col-md-6"><label for="keyword" class="form-label">キーワード</label><input id="keyword" name="keyword" value="@ViewBag.Keyword" class="form-control" /></div><div class="col-md-2"><label for="type" class="form-label">種別</label><select id="type" name="type" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<DataAssetType>()) { <option value="@value" selected="@(ViewBag.Type?.ToString() == value.ToString())">@value</option> }</select></div><div class="col-md-2"><label for="status" class="form-label">状態</label><select id="status" name="status" class="form-select"><option value="">すべて</option>@foreach (var value in Enum.GetValues<LifecycleStatus>()) { <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString())">@value</option> }</select></div><div class="col-md-2"><button class="btn btn-primary w-100">検索</button></div></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>名称</th><th>種別</th><th>システム</th><th>所有部署</th><th>機密区分</th><th>状態</th><th>最終確認</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.DataType</td><td>@item.SystemName</td><td>@(item.OwnerDepartment ?? "-")</td><td>@(item.ConfidentialityClassification ?? "未設定")</td><td>@item.Status</td><td>@(item.LastReviewedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "未確認")</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7"><div class="empty-state">データ資産はありません。</div></td></tr> }
</tbody></table></div>

