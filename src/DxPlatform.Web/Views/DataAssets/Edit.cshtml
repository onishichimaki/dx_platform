@model DataAssetInputModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "データ資産編集" : "データ資産登録";
    var apps = ViewBag.AllApplications as IEnumerable<ApplicationAsset> ?? Enumerable.Empty<ApplicationAsset>();
    var agents = ViewBag.AllAgents as IEnumerable<AgentAsset> ?? Enumerable.Empty<AgentAsset>();
    var dataAssets = ViewBag.AllDataAssets as IEnumerable<DataAsset> ?? Enumerable.Empty<DataAsset>();
}
<h1 class="h2">@ViewData["Title"]</h1>
<form method="post" class="form-section"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-3"><label asp-for="DataType" class="form-label"></label><select asp-for="DataType" asp-items="Html.GetEnumSelectList<DataAssetType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<LifecycleStatus>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="SystemName" class="form-label required-label"></label><input asp-for="SystemName" class="form-control" /><span asp-validation-for="SystemName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ConnectionReferenceName" class="form-label"></label><input asp-for="ConnectionReferenceName" class="form-control" /><span asp-validation-for="ConnectionReferenceName" class="text-danger"></span><div class="form-text">接続文字列やパスワードではなく、承認済み参照名のみ。</div></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="OwnerDepartment" class="form-label"></label><input asp-for="OwnerDepartment" class="form-control" /></div><div class="col-md-4"><label asp-for="DataOwner" class="form-label"></label><input asp-for="DataOwner" class="form-control" /></div><div class="col-md-4"><label asp-for="UpdateFrequency" class="form-label"></label><input asp-for="UpdateFrequency" class="form-control" /></div>
<div class="col-md-4"><label asp-for="ConfidentialityClassification" class="form-label"></label><input asp-for="ConfidentialityClassification" class="form-control" /></div><div class="col-md-4"><label asp-for="RetentionPeriod" class="form-label"></label><input asp-for="RetentionPeriod" class="form-control" /></div><div class="col-md-4"><label asp-for="LastReviewedAt" class="form-label"></label><input asp-for="LastReviewedAt" class="form-control" /></div><div class="col-12"><label asp-for="TagsText" class="form-label"></label><input asp-for="TagsText" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
<div class="col-md-4"><label asp-for="RelatedApplicationIds" class="form-label"></label><select asp-for="RelatedApplicationIds" class="form-select" multiple size="6">@foreach (var item in apps) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-4"><label asp-for="RelatedAgentIds" class="form-label"></label><select asp-for="RelatedAgentIds" class="form-select" multiple size="6">@foreach (var item in agents) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-4"><label asp-for="RelatedDataAssetIds" class="form-label"></label><select asp-for="RelatedDataAssetIds" class="form-select" multiple size="6">@foreach (var item in dataAssets) { <option value="@item.Id">@item.Name</option> }</select></div>
</div><div class="mt-3 d-flex gap-2"><button class="btn btn-primary">保存</button><a class="btn btn-outline-secondary" asp-action="Index">キャンセル</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

