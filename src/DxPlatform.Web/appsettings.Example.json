{
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-server>;Database=<database>;User Id=<user>;Password=<secret-from-secure-store>;Encrypt=True;TrustServerCertificate=False"
  },
  "BootstrapAdmin": {
    "Email": "<set-by-environment-variable>",
    "Password": "<set-by-environment-variable>"
  },
  "DeploymentApi": {
    "Token": "<set-by-environment-variable>"
  },
  "DemoData": {
    "Enabled": false
  }
}
