{
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-server>;Database=<database>;User Id=<user>;Password=<secret-from-secure-store>;Encrypt=True;TrustServerCertificate=False"
  },
  "BootstrapAdmin": {
    "Email": "<set-by-environment-variable>",
    "Password": "<set-by-environment-variable>"
  },
  "DeploymentApi": {
    "Token": "<set-by-environment-variable>"
  },
  "HealthChecks": {
    "TimeoutSeconds": 10,
    "AllowedHosts": ["<exact-internal-health-host>"],
    "AllowedPorts": [443],
    "AllowPrivateAddresses": false
  },
  "DataProtection": {
    "ApplicationName": "DxPlatform-Production",
    "KeyRingPath": "<absolute-acl-protected-key-ring-path>"
  },
  "DemoData": {
    "Enabled": false
  },
  "AllowedHosts": "<portal-hostname>"
}
