{
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "DemoData": {
    "Enabled": false
  },
  "HealthChecks": {
    "TimeoutSeconds": 10,
    "AllowedHosts": [],
    "AllowedPorts": [443],
    "AllowPrivateAddresses": false
  },
  "DataProtection": {
    "ApplicationName": "DxPlatform",
    "KeyRingPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Path": "logs/dxplatform-.log"
    }
  },
  "AllowedHosts": "*"
}
