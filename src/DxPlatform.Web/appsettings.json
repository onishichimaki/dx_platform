{
  "Database": {
    "Provider": "SqlServer"
  },
  "DemoData": {
    "Enabled": false
  },
  "HealthChecks": {
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Path": "logs/dxplatform-.log"
    }
  },
  "AllowedHosts": "*"
}
