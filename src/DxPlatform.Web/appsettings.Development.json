{
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dxplatform.dev.db"
  },
  "DemoData": {
    "Enabled": true
  },
  "HealthChecks": {
    "AllowedHosts": ["example.com"],
    "AllowedPorts": [443],
    "AllowPrivateAddresses": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
